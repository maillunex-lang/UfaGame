# Proposed local configuration for S05. No service reads this file in S02.
APP_ENV=local
API_HOST=127.0.0.1
# 0 means request a free ephemeral port in future local tooling.
API_PORT=0
DATABASE_URL=
CONTENT_ROOT=./private/content
# Admin endpoints fail closed until this HTTPS origin is configured.
ADMIN_ORIGIN=
ADMIN_COOKIE_PATH=/game/server/admin/v1
# Owner bootstrap only; password file must be private0600, never a public asset.
UFAGAME_OWNER_LOGIN=
UFAGAME_OWNER_PASSWORD_FILE=
