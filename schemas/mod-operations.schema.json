{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "op",
      "entity_type",
      "id"
    ],
    "properties": {
      "op": {
        "enum": [
          "create",
          "replace",
          "delete"
        ]
      },
      "entity_type": {
        "type": "string",
        "minLength": 1
      },
      "id": {
        "type": "string",
        "minLength": 1
      },
      "source": {
        "type": "string",
        "minLength": 1
      },
      "expected_revision": {
        "type": "integer",
        "minimum": 1
      },
      "compensation_rule_id": {
        "type": "string",
        "minLength": 1
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "op": {
              "const": "create"
            }
          }
        },
        "then": {
          "required": [
            "source"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "expected_revision"
                ]
              },
              {
                "required": [
                  "compensation_rule_id"
                ]
              }
            ]
          }
        }
      },
      {
        "if": {
          "properties": {
            "op": {
              "const": "replace"
            }
          }
        },
        "then": {
          "required": [
            "source",
            "expected_revision"
          ],
          "not": {
            "required": [
              "compensation_rule_id"
            ]
          }
        }
      },
      {
        "if": {
          "properties": {
            "op": {
              "const": "delete"
            }
          }
        },
        "then": {
          "required": [
            "expected_revision"
          ],
          "not": {
            "required": [
              "source"
            ]
          }
        }
      }
    ]
  }
}
