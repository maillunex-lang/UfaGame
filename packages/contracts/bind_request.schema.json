{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufagame.invalid/contracts/v1/bind_request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "login",
    "password"
  ],
  "properties": {
    "login": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]{3,32}$"
    },
    "password": {
      "type": "string",
      "minLength": 12,
      "maxLength": 128
    }
  }
}
