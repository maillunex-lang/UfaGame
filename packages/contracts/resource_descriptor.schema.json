{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ufagame.invalid/contracts/v1/resource_descriptor",
 "oneOf": [
  {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "media_type",
    "sha256",
    "size",
    "width",
    "height",
    "license",
    "scale_bp",
    "anchor",
    "frames",
    "loop"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]{2,79}$"
    },
    "media_type": {
     "const": "image/png"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    },
    "size": {
     "type": "integer",
     "minimum": 1,
     "maximum": 8388608
    },
    "width": {
     "type": "integer",
     "minimum": 1,
     "maximum": 4096
    },
    "height": {
     "type": "integer",
     "minimum": 1,
     "maximum": 4096
    },
    "license": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "name",
      "attribution"
     ],
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1,
       "maxLength": 120
      },
      "attribution": {
       "type": "string",
       "maxLength": 500
      }
     }
    },
    "scale_bp": {
     "type": "integer",
     "minimum": 100,
     "maximum": 100000
    },
    "anchor": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "x",
      "y"
     ],
     "properties": {
      "x": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "y": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      }
     }
    },
    "frames": {
     "type": "array",
     "minItems": 1,
     "maxItems": 120,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "x",
       "y",
       "width",
       "height",
       "duration_ms"
      ],
      "properties": {
       "x": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4096
       },
       "y": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4096
       },
       "width": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4096
       },
       "height": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4096
       },
       "duration_ms": {
        "type": "integer",
        "minimum": 20,
        "maximum": 60000
       }
      }
     }
    },
    "loop": {
     "type": "boolean"
    }
   }
  },
  {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "media_type",
    "sha256",
    "size",
    "duration_ms",
    "sample_rate",
    "channels",
    "bits_per_sample",
    "license",
    "loop"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]{2,79}$"
    },
    "media_type": {
     "const": "audio/wav"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    },
    "size": {
     "type": "integer",
     "minimum": 1,
     "maximum": 8388608
    },
    "duration_ms": {
     "type": "integer",
     "minimum": 1,
     "maximum": 120000
    },
    "sample_rate": {
     "type": "integer",
     "minimum": 8000,
     "maximum": 48000
    },
    "channels": {
     "type": "integer",
     "minimum": 1,
     "maximum": 2
    },
    "bits_per_sample": {
     "enum": [
      8,
      16
     ]
    },
    "license": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "name",
      "attribution"
     ],
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1,
       "maxLength": 120
      },
      "attribution": {
       "type": "string",
       "maxLength": 500
      }
     }
    },
    "loop": {
     "type": "boolean"
    }
   }
  }
 ]
}
