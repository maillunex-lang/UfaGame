{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufagame.invalid/contracts/v1/hero_team_request",
  "title": "POST /v1/heroes/team: whole arrangement of main five and sync slots",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "main",
    "sync"
  ],
  "properties": {
    "main": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "sync": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  }
}
