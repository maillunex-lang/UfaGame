{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufagame.invalid/contracts/v1/battle_snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "battle_id",
    "content_version",
    "simulation_version",
    "seed",
    "actors",
    "last_seq"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "battle_id": {
      "type": "string",
      "format": "uuid"
    },
    "content_version": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,79}$"
    },
    "simulation_version": {
      "const": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "hp"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,79}$"
          },
          "hp": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      },
      "minItems": 1,
      "maxItems": 10
    },
    "last_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    }
  }
}
