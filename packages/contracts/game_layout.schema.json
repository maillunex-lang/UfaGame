{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufagame.invalid/contracts/v1/game_layout",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "nodes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "parent",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,39}$"
              },
              "parent": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-z][a-z0-9_]{2,39}$"
              },
              "type": {
                "const": "column"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "parent",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,39}$"
              },
              "parent": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-z][a-z0-9_]{2,39}$"
              },
              "type": {
                "const": "row"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "parent",
              "type",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,39}$"
              },
              "parent": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-z][a-z0-9_]{2,39}$"
              },
              "type": {
                "const": "label"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "parent",
              "type",
              "binding"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,39}$"
              },
              "parent": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-z][a-z0-9_]{2,39}$"
              },
              "type": {
                "const": "binding"
              },
              "binding": {
                "enum": [
                  "world_name",
                  "player_name"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "parent",
              "type",
              "text",
              "action"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,39}$"
              },
              "parent": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-z][a-z0-9_]{2,39}$"
              },
              "type": {
                "const": "button"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "action": {
                "enum": [
                  "open_campaign",
                  "open_heroes",
                  "open_quests"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
