{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufagame.invalid/contracts/v1/resource_upload_request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "license",
    "scale_bp",
    "loop",
    "data_base64",
    "reason",
    "request_id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,79}$"
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "attribution"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "attribution": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "scale_bp": {
      "type": "integer",
      "minimum": 100,
      "maximum": 100000
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y",
          "width",
          "height",
          "duration_ms"
        ],
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 20,
            "maximum": 60000
          }
        }
      }
    },
    "loop": {
      "type": "boolean"
    },
    "data_base64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 11184812,
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    },
    "reason": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
