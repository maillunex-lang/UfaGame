{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufagame.invalid/contracts/v1/import_preflight_request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expected_revision",
    "zip_base64"
  ],
  "properties": {
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483646
    },
    "zip_base64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 11184812,
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    },
    "resolutions": {
      "type": "object",
      "maxProperties": 5000,
      "propertyNames": {
        "pattern": "^(base|entity:[a-z][a-z0-9_]{2,79}|resource:[a-z][a-z0-9_]{2,79})$"
      },
      "additionalProperties": {
        "enum": [
          "package",
          "draft"
        ]
      }
    }
  }
}
