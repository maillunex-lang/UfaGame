{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufagame.invalid/contracts/v1/battle_record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "simulation_version",
    "seed",
    "result",
    "steps",
    "duration_ms",
    "event_count",
    "event_log_sha256",
    "actors",
    "frames",
    "events",
    "events_truncated",
    "battle_id",
    "content_version",
    "stage_id",
    "rewards"
  ],
  "properties": {
    "api_version": {
      "const": 1
    },
    "simulation_version": {
      "const": 2
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "result": {
      "enum": [
        "attacker_win",
        "attacker_loss"
      ]
    },
    "steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 900
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 90000
    },
    "event_count": {
      "type": "integer",
      "minimum": 0
    },
    "event_log_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "actors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actor_id",
          "hero_id",
          "team",
          "slot",
          "faction_id",
          "max_hp",
          "hp",
          "damage_dealt",
          "healing_done",
          "damage_taken"
        ],
        "properties": {
          "actor_id": {
            "type": "string",
            "pattern": "^(atk|def)_[0-4]$"
          },
          "hero_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,79}$"
          },
          "team": {
            "enum": [
              "attacker",
              "defender"
            ]
          },
          "slot": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "faction_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,79}$"
          },
          "max_hp": {
            "type": "integer",
            "minimum": 1
          },
          "hp": {
            "type": "integer",
            "minimum": 0
          },
          "damage_dealt": {
            "type": "integer",
            "minimum": 0
          },
          "healing_done": {
            "type": "integer",
            "minimum": 0
          },
          "damage_taken": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 2,
      "maxItems": 182,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at_ms",
          "actors"
        ],
        "properties": {
          "at_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 90000
          },
          "actors": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at_ms",
          "kind",
          "source_id",
          "target_id",
          "amount"
        ],
        "properties": {
          "at_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 90000
          },
          "kind": {
            "enum": [
              "damage",
              "heal",
              "stun",
              "knockback"
            ]
          },
          "source_id": {
            "type": "string",
            "pattern": "^(atk|def)_[0-4]$"
          },
          "target_id": {
            "type": "string",
            "pattern": "^(atk|def)_[0-4]$"
          },
          "amount": {
            "type": "integer",
            "minimum": 0
          },
          "ability_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,79}$"
          }
        }
      }
    },
    "events_truncated": {
      "type": "boolean"
    },
    "battle_id": {
      "type": "string",
      "format": "uuid"
    },
    "content_version": {
      "type": "string",
      "pattern": "^pub_[0-9]{6,}$"
    },
    "stage_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,79}$"
    },
    "rewards": {
      "type": "array",
      "maxItems": 0
    }
  }
}
