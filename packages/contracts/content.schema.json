{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufagame.invalid/contracts/v1/content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_version",
    "required_capabilities",
    "entities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "content_version": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,79}$"
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "content.core.v1",
          "battle.hp.v1",
          "ui.label.v1",
          "auth.guest.v1",
          "auth.password.v1",
          "battle.combat.v1",
          "content.resources.v1",
          "battle.abilities.v2",
          "world.locations.v1",
          "battle.triggers.v1"
        ]
      },
      "uniqueItems": true,
      "maxItems": 20
    },
    "entities": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "name",
              "data"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,79}$"
              },
              "kind": {
                "const": "hero"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "faction_id",
                  "ability_ids"
                ],
                "properties": {
                  "faction_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{2,79}$"
                  },
                  "ability_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{2,79}$"
                    },
                    "minItems": 1,
                    "maxItems": 8,
                    "uniqueItems": true
                  },
                  "combat": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "hp",
                      "attack",
                      "defense",
                      "speed",
                      "range",
                      "attack_interval_ms",
                      "energy_start",
                      "energy_per_second",
                      "energy_per_attack"
                    ],
                    "properties": {
                      "hp": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000000
                      },
                      "attack": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000
                      },
                      "defense": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000
                      },
                      "speed": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 5000
                      },
                      "range": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 20000
                      },
                      "attack_interval_ms": {
                        "type": "integer",
                        "minimum": 100,
                        "maximum": 90000,
                        "multipleOf": 100
                      },
                      "energy_start": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000
                      },
                      "energy_per_second": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000,
                        "multipleOf": 10
                      },
                      "energy_per_attack": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000
                      }
                    }
                  },
                  "sprite_resource_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{2,79}$"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "name",
              "data"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,79}$"
              },
              "kind": {
                "const": "ability"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "effect",
                  "power",
                  "cooldown_ms"
                ],
                "properties": {
                  "effect": {
                    "enum": [
                      "damage",
                      "heal",
                      "stun",
                      "knockback"
                    ]
                  },
                  "power": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "cooldown_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "energy_cost": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "sound_resource_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{2,79}$"
                  },
                  "target": {
                    "enum": [
                      "enemy",
                      "weakest_enemy",
                      "all_enemies",
                      "ally_lowest",
                      "self"
                    ]
                  },
                  "trigger": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "interval",
                          "self_hp_below",
                          "ally_hp_below",
                          "battle_start"
                        ]
                      },
                      "percent": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 99
                      }
                    }
                  },
                  "extra_effects": {
                    "type": "array",
                    "maxItems": 2,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "effect",
                        "power"
                      ],
                      "properties": {
                        "effect": {
                          "enum": [
                            "damage",
                            "heal",
                            "stun",
                            "knockback"
                          ]
                        },
                        "power": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 2147483647
                        },
                        "target": {
                          "enum": [
                            "enemy",
                            "weakest_enemy",
                            "all_enemies",
                            "ally_lowest",
                            "self"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "name",
              "data"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,79}$"
              },
              "kind": {
                "const": "faction"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "advantage_ids"
                ],
                "properties": {
                  "advantage_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{2,79}$"
                    },
                    "maxItems": 6,
                    "uniqueItems": true
                  },
                  "advantage_bp": {
                    "type": "integer",
                    "minimum": 10000,
                    "maximum": 20000
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "name",
              "data"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,79}$"
              },
              "kind": {
                "const": "item"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "stack_limit",
                  "slot"
                ],
                "properties": {
                  "stack_limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "slot": {
                    "enum": [
                      "none",
                      "weapon",
                      "armor",
                      "helmet",
                      "boots",
                      "jewelry",
                      "artifact"
                    ]
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "name",
              "data"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,79}$"
              },
              "kind": {
                "const": "stage"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "enemy_hero_ids",
                  "time_limit_ms"
                ],
                "properties": {
                  "enemy_hero_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{2,79}$"
                    },
                    "minItems": 1,
                    "maxItems": 5
                  },
                  "time_limit_ms": {
                    "const": 90000
                  },
                  "location_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{2,79}$"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "name",
              "data"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,79}$"
              },
              "kind": {
                "const": "ui_label"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 500
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "name",
              "data"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,79}$"
              },
              "kind": {
                "const": "dialogue_template"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "cooldown_seconds"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "cooldown_seconds": {
                    "type": "integer",
                    "minimum": 60,
                    "maximum": 86400
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "name",
              "data"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,79}$"
              },
              "kind": {
                "const": "location"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "level",
                  "lat_e6",
                  "lon_e6",
                  "source"
                ],
                "properties": {
                  "level": {
                    "enum": [
                      "republic",
                      "district",
                      "city",
                      "point"
                    ]
                  },
                  "parent_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{2,79}$"
                  },
                  "lat_e6": {
                    "type": "integer",
                    "minimum": -90000000,
                    "maximum": 90000000
                  },
                  "lon_e6": {
                    "type": "integer",
                    "minimum": -180000000,
                    "maximum": 180000000
                  },
                  "name_ba": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "centre_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "source": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "id",
                          "retrieved"
                        ],
                        "properties": {
                          "kind": {
                            "const": "wikidata"
                          },
                          "id": {
                            "type": "string",
                            "pattern": "^Q[1-9][0-9]{0,11}$"
                          },
                          "retrieved": {
                            "type": "string",
                            "format": "date"
                          },
                          "candidates": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 100
                          },
                          "corrected": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "from_lat_e6",
                              "from_lon_e6",
                              "reason"
                            ],
                            "properties": {
                              "from_lat_e6": {
                                "type": "integer",
                                "minimum": -90000000,
                                "maximum": 90000000
                              },
                              "from_lon_e6": {
                                "type": "integer",
                                "minimum": -180000000,
                                "maximum": 180000000
                              },
                              "reason": {
                                "type": "string",
                                "minLength": 3,
                                "maxLength": 200
                              }
                            }
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind"
                        ],
                        "properties": {
                          "kind": {
                            "const": "manual"
                          },
                          "note": {
                            "type": "string",
                            "maxLength": 300
                          }
                        }
                      }
                    ]
                  },
                  "art": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "resource_id",
                      "x",
                      "y"
                    ],
                    "properties": {
                      "resource_id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{2,79}$"
                      },
                      "x": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4096
                      },
                      "y": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4096
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "maxItems": 10000
    }
  }
}
