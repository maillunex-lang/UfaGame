{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufagame.invalid/contracts/v1/battle_start_request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "stage_id",
    "hero_ids"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "stage_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,79}$"
    },
    "hero_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{2,79}$"
      }
    }
  }
}
