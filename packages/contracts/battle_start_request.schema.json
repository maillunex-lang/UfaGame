{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufagame.invalid/contracts/v1/battle_start_request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "stage_id"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "stage_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,79}$"
    },
    "hero_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{2,79}$"
      }
    },
    "instance_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "hero_ids"
      ],
      "properties": {
        "hero_ids": {
          "$ref": "#/properties/hero_ids"
        }
      }
    },
    {
      "required": [
        "instance_ids"
      ],
      "properties": {
        "instance_ids": {
          "$ref": "#/properties/instance_ids"
        }
      }
    }
  ]
}
