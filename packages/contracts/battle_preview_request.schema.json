{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufagame.invalid/contracts/v1/battle_preview_request",
  "type": "object",
  "additionalProperties": false,
  "required": ["expected_revision", "attacker_hero_ids", "seed"],
  "properties": {
    "expected_revision": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "attacker_hero_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$"}
    },
    "defender_hero_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$"}
    },
    "stage_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295}
  }
}
