{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufagame.invalid/contracts/v1/quest_claim_request",
  "title": "POST /v1/quests/claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "quest_id"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "quest_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,79}$"
    }
  }
}
