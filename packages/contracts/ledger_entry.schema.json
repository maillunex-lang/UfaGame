{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufagame.invalid/contracts/v1/ledger_entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "player_id",
    "currency",
    "delta",
    "balance",
    "reason",
    "source_id",
    "idempotency_key"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "player_id": {
      "type": "string",
      "format": "uuid"
    },
    "currency": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,79}$"
    },
    "delta": {
      "type": "integer",
      "minimum": -2147483647,
      "maximum": 2147483647
    },
    "balance": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "reason": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,79}$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    }
  }
}
