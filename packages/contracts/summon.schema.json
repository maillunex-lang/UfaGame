{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufagame.invalid/contracts/v1/summon",
  "title": "GET /v1/summon and pull responses: server odds, guarantee counters, shards, last results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "content_version",
    "balances",
    "pools",
    "shards",
    "last"
  ],
  "properties": {
    "api_version": {
      "const": 1
    },
    "content_version": {
      "type": "string"
    },
    "balances": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "pools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "cost",
          "odds",
          "guarantee",
          "shards_per_hero",
          "proposed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,79}$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "currency",
              "amount"
            ],
            "properties": {
              "currency": {
                "enum": [
                  "gold",
                  "gems"
                ]
              },
              "amount": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "odds": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hero_id",
                "name",
                "shards",
                "weight",
                "chance_pct"
              ],
              "properties": {
                "hero_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{2,79}$"
                },
                "name": {
                  "type": "string"
                },
                "shards": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "weight": {
                  "type": "integer",
                  "minimum": 0
                },
                "chance_pct": {
                  "type": "string",
                  "pattern": "^[0-9]{1,3}\\.[0-9]{2}$"
                }
              }
            }
          },
          "guarantee": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "every",
                  "hero_names",
                  "pulls_left"
                ],
                "properties": {
                  "every": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "hero_names": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "pulls_left": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            ]
          },
          "shards_per_hero": {
            "type": [
              "integer",
              "null"
            ]
          },
          "proposed": {
            "type": "boolean"
          }
        }
      }
    },
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hero_id",
          "name",
          "amount"
        ],
        "properties": {
          "hero_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,79}$"
          },
          "name": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "last": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hero_id",
              "name",
              "shards",
              "guaranteed",
              "new_instance_id"
            ],
            "properties": {
              "hero_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,79}$"
              },
              "name": {
                "type": "string"
              },
              "shards": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "guaranteed": {
                "type": "boolean"
              },
              "new_instance_id": {
                "oneOf": [
                  {
                    "type": "string",
                    "format": "uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
